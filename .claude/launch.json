{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "motokoi",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "motokoi-aberto",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "motokoi-producao",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "referencia",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4100", "--bind", "127.0.0.1", "--directory", "motokoi-site/design"],
      "port": 4100
    }
  ]
}
